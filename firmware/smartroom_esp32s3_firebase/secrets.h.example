// CARA PAKAI:
// 1. Salin file ini menjadi "secrets.h" di folder yang sama.
// 2. Isi kredensial asli proyek Firebase Anda pada "secrets.h".
// 3. File "secrets.h" otomatis diabaikan oleh .gitignore (JANGAN di-commit!).
// ==============================================================================

// Kredensial Hotspot / Wi-Fi 2.4 GHz
#define WIFI_SSID               "NAMA_WIFI_ATAU_HOTSPOT_ANDA"
#define WIFI_PASSWORD           "PASSWORD_WIFI_ANDA"

// URL Firebase Realtime Database (TANPA garis miring '/' di akhir)
// Contoh: "https://proyek-anda-default-rtdb.asia-southeast1.firebasedatabase.app"
#define FIREBASE_RTDB_URL       "https://GANTI-PROJECT-ID-default-rtdb.asia-southeast1.firebasedatabase.app"

// Web API Key dari Firebase Console -> Project Settings -> General
#define FIREBASE_WEB_API_KEY    "GANTI_DENGAN_WEB_API_KEY_FIREBASE"

// Akun Email/Password Khusus Perangkat ESP32 (role: "device" di /users/{uid})
#define FIREBASE_DEVICE_EMAIL   "device@smartroom.local"
#define FIREBASE_DEVICE_PASSWORD "GANTI_PASSWORD_AKUN_DEVICE"
