{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "room1": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').exists()",
      "current": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Device'",
        ".validate": "newData.hasChildren(['temperature', 'humidity', 'airDelta', 'airLabel', 'lightLux', 'presence', 'fanStatus', 'lampStatus', 'timestamp'])"
      },
      "actuator": {
        "fanMode": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Staff'",
          ".validate": "newData.isString() && (newData.val() === 'auto' || newData.val() === 'on' || newData.val() === 'off')"
        },
        "lampMode": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Staff'",
          ".validate": "newData.isString() && (newData.val() === 'auto' || newData.val() === 'on' || newData.val() === 'off')"
        }
      },
      "alarm": {
        "active": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Device'",
          ".validate": "newData.isBoolean()"
        },
        "buzzer": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Device'",
          ".validate": "newData.isBoolean()"
        },
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Device'",
          ".validate": "newData.isString() && (newData.val() === 'normal' || newData.val() === 'aktif' || newData.val() === 'dibungkam')"
        },
        "reason": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Device'",
          ".validate": "newData.isString()"
        },
        "mute": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Staff' || root.child('users').child(auth.uid).child('role').val() === 'Device')",
          ".validate": "newData.isBoolean()"
        }
      },
      "thresholds": {
        ".write": false
      },
      "history": {
        "$epoch": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Device'",
          ".validate": "newData.hasChildren(['temperature', 'humidity', 'airDelta', 'airAqi', 'lightLux', 'timestamp'])"
        }
      },
      "events": {
        ".indexOn": ["timestamp", "type"],
        "$eventId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Device'",
          ".validate": "newData.hasChildren(['timestamp', 'type', 'severity', 'message'])"
        }
      }
    }
  }
}
